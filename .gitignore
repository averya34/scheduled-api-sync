# Byte-compiled / optimised
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build artefacts
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Secrets and local configuration. Nothing in this family should ever be
# committed; the SECURITY.md threat model assumes it never is.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# Runtime state written by sync jobs
.state/
*.checkpoint.json
*.corrupt-*

# Editors and OS noise
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
